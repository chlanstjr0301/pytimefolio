% DART research note style (Nomura-like layout, DART navy theme). XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dart}[2026/11/24 DART research note]
% Page geometry from 7709 연구.docx: A4, margins 12.7mm, header at 18.0mm (2 lines Arial 9pt -> header bottom 25.1mm),
% cover table at 26.8mm with columns 140.0mm | 46.4mm and 1.9mm cell padding. Body pages reuse the same grid:
% main column x 14.6–150.8mm (136.2mm), right column x 154.6–195.4mm; wide blocks span 14.6–195.4mm.
% Page 1 only carries the docx header band (cover.tex places its content absolutely and pushes the text block down to 26.8mm).
% Pages 2+ follow the Nomura body page: one running-header line (baseline 10.0mm), navy rule at 12.0mm, text from 17.0mm.
\RequirePackage[a4paper,top=17mm,bottom=17mm,left=14.6mm,textwidth=136.2mm,headheight=0mm,headsep=0mm,footskip=8mm,marginparwidth=0mm]{geometry}
\RequirePackage{fontspec}
% Windows (MiKTeX): Arial, Malgun Gothic, Consolas. Elsewhere: substitute fonts for previews only.
\IfFontExistsTF{Arial}{%
  \setmainfont{Arial}[BoldFont={Arial Bold},ItalicFont={Arial Italic},BoldItalicFont={Arial Bold Italic}]%
  \setsansfont{Arial}}{%
  \setmainfont{Liberation Sans}\setsansfont{Liberation Sans}}
\IfFontExistsTF{Consolas}{\setmonofont{Consolas}[Scale=0.92]}{\setmonofont{DejaVu Sans Mono}[Scale=0.84]}
\IfFontExistsTF{Malgun Gothic}{\newfontfamily\kofont{Malgun Gothic}[BoldFont={Malgun Gothic Bold}]}{\newfontfamily\kofont{Liberation Sans}}
\RequirePackage{xcolor}
\definecolor{navy}{HTML}{161C3C}   % main (cover band)
\definecolor{navyM}{HTML}{526A9A}
\definecolor{navyL}{HTML}{A8B7D1}
\definecolor{navyXL}{HTML}{E2E5EA}
\definecolor{greyD}{HTML}{6B6F78}
\definecolor{greyM}{HTML}{A6AAB2}
\definecolor{accent}{HTML}{D18A45} % orange: event lines only
\definecolor{diagA}{HTML}{232B52}  % header diagonal 1 (docx)
\definecolor{diagB}{HTML}{2E3763}  % header diagonal 2 (docx)
\definecolor{subgrey}{HTML}{808080} % cover subtitle (docx)
\definecolor{body}{HTML}{1A1A1A}   % docx Normal text colour
\RequirePackage{graphicx,tikz,changepage,booktabs,array,tabularx,colortbl,enumitem,fancyhdr,ragged2e,calc,xparse}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{microtype}
\RequirePackage{needspace}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\linespread{1.08}
\renewcommand{\normalsize}{\fontsize{9.5}{12.6}\selectfont}
\normalsize
\setlist{leftmargin=11pt,itemsep=2pt,topsep=2pt,parsep=0pt,label={\color{navy}\textbullet}}
\newlength{\extrawide}\setlength{\extrawide}{44.6mm} % 195.4mm - 150.8mm: wide blocks reach the right column edge
\newcommand{\reportseries}{pytimefolio}
\newcommand{\reportdate}{24 November 2026}
% header1.xml replica (page 1 only)
\IfFontExistsTF{Bodoni MT}{\newfontfamily\bodoni{Bodoni MT}[BoldFont={Bodoni MT Bold}]}{\newfontfamily\bodoni{DejaVu Serif}}
\newcommand{\dartheader}{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm,shift={(current page.north west)}]
    \fill[navy] (-3,-3) rectangle (213,16.306);  % rect 210 x 16.2mm; bled 3mm past the left, right and top edges (print bleed)
    \fill[diagA] (149.657,-3) -- (213,-3) -- (213,16.157) -- (170.818,16.157) -- cycle; % diag1 (slope kept: x 152.42 at y -0.5, 170.82 at 16.16)
    \fill[diagB] (169.111,-3) -- (213,-3) -- (213,16.157) -- (191.900,16.157) -- cycle; % diag2 (slope kept: x 172.09 at y -0.5, 191.90 at 16.16)
    \node[anchor=north west,inner sep=0] at (5.59,2.93) {\includegraphics[width=9.65mm]{assets/image1.png}}; % logo 9.65mm (PDF bbox 5.59,2.93-15.24,12.58)
    \node[anchor=base west,inner sep=0,text=white] at (18.85,11.05) {\bodoni\bfseries\fontsize{28}{28}\selectfont\addfontfeatures{LetterSpace=9.9}DART}; % measured from docx PDF
    \node[anchor=base west,inner sep=0] at (165.87,20.95) {\fontsize{9}{9}\selectfont\addfontfeatures{LetterSpace=1.4}\color{navy}Quantitative Research};
    \node[anchor=base east,inner sep=0] at (197.38,24.60) {\fontsize{9}{9}\selectfont\addfontfeatures{LetterSpace=1.4}\color{navy}\reportdatenum}; % right edge = 181.48+15.90
  \end{tikzpicture}}
\newcommand{\reportdatenum}{2026.11.24}
% Nomura-style running header for pages 2+: left "DART | 7709.HK In-Depth", right date, navy rule across the full grid (14.6–195.4mm)
\newcommand{\bodyheader}{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm,shift={(current page.north west)}]
    \node[anchor=base west,inner sep=0] at (14.6,10.0) {\fontsize{8}{8}\selectfont{\color{navy}DART}\,{\color{greyD}| \reportseries}};
    \node[anchor=base east,inner sep=0] at (195.4,10.0) {\fontsize{8}{8}\selectfont\color{greyD}\reportdate};
    \fill[navy] (14.6,11.85) rectangle (195.4,12.15);
  \end{tikzpicture}}
\newcommand{\pagenum}{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm,shift={(current page.north west)}]
    \node[anchor=base east,inner sep=0] at (195.4,287.0) {\fontsize{8}{8}\selectfont\color{body}\thepage};
  \end{tikzpicture}}
\fancypagestyle{dartpage}{\fancyhf{}\renewcommand{\headrule}{}\renewcommand{\footrule}{}\fancyhead[L]{\dartheader}\fancyfoot[R]{\pagenum}}
\fancypagestyle{dartbody}{\fancyhf{}\renewcommand{\headrule}{}\renewcommand{\footrule}{}\fancyhead[L]{\bodyheader}\fancyfoot[R]{\pagenum}}
\pagestyle{dartbody}
% section heading = claim sentence
\newcommand{\claim}[1]{\par\vspace{6pt}{\fontsize{10.5}{13}\selectfont\bfseries\color{navy}\RaggedRight\hyphenpenalty=10000 \exhyphenpenalty=10000 \relax #1\par}\vspace{1pt}}
\newcommand{\lead}[1]{{\bfseries #1}}
\newcommand{\figref}[1]{{\color{navyM}\itshape Figure~#1}}
% figure block: caption above with rule, optional subtitle, body, Note/Source below
\NewDocumentCommand{\figblock}{ o m m o m m m }{% [wide] number title [subtitle] body note source
  \par\Needspace{16\baselineskip}\vspace{4pt}\noindent\begingroup\setlength{\parskip}{0pt}
  \IfValueTF{#1}{\begin{adjustwidth}{0pt}{-\extrawide}}{\begin{adjustwidth}{0pt}{0pt}}
  {\color{navy}\rule{\linewidth}{0.8pt}}\par\vspace{1pt}
  {\fontsize{9}{11}\selectfont\bfseries Figure #2. #3\par}
  \IfValueT{#4}{{\fontsize{8}{10}\selectfont\color{greyD}#4\par}}
  \vspace{3pt}{\centering #5\par}\vspace{2pt}
  {\fontsize{7}{8.6}\selectfont\color{greyD}\RaggedRight Note: #6\par Source: #7\par}
  \vspace{1pt}{\color{black}\rule{\linewidth}{0.4pt}}
  \end{adjustwidth}\endgroup\par\vspace{2pt}}
% navy-header table helpers
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\arraybackslash}p{#1}}
\newcommand{\thd}[1]{\cellcolor{navy}\textcolor{white}{\bfseries #1}}
\newcommand{\rowsep}{\arrayrulecolor{greyM}\specialrule{0.3pt}{1pt}{1pt}\arrayrulecolor{black}}
\endinput
